# Copy to .env (gitignored) and fill in.

# Google SSO — the OAuth client must list http://localhost:3001 as an authorised JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Gemini (document extraction)
GEMINI_API_KEY=
ACCOUNTING_GEMINI_MODEL=gemini-3.8-flash
ACCOUNTING_GEMINI_THINKING_LEVEL=low
# Firm assistant only; document extraction above still uses Gemini.
# Native Ollama: base has NO /v1 suffix. Pull qwen3:4b-instruct on the Mac host first.
ASSISTANT_LLM_PROVIDER=ollama
ASSISTANT_LLM_BASE_URL=http://host.docker.internal:11434
ASSISTANT_LLM_MODEL=qwen3:4b-instruct
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_THINK=false
ASSISTANT_LLM_KEEP_ALIVE=30m
ASSISTANT_LLM_NUM_CTX=16384
ASSISTANT_LLM_MAX_OUTPUT_TOKENS=1024
# Per-call read timeout; connect timeout is fixed at 5 seconds. No retry on read timeout.
ASSISTANT_LLM_TIMEOUT_SECONDS=90
ASSISTANT_TURN_SECONDS=180
# Lookup rounds, calls executed per round, and characters of JSON per observation.
ASSISTANT_MAX_STEPS=5
ASSISTANT_MAX_CALLS_PER_STEP=3
ASSISTANT_OBSERVATION_CHARS=6000
# History messages, characters per message, total history character budget; answer characters.
ASSISTANT_HISTORY_TURNS=12
ASSISTANT_HISTORY_CHARS=800
ASSISTANT_HISTORY_BUDGET_CHARS=4000
ASSISTANT_ANSWER_CHARS=4000
# Hosted Qwen: change these four env vars, then recreate backend:
# ASSISTANT_LLM_PROVIDER=openai
# ASSISTANT_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# ASSISTANT_LLM_MODEL=qwen-plus
# ASSISTANT_LLM_API_KEY=your-DashScope-key

# Auth — any random string >= 32 chars (required outside development)
JWT_SECRET=change-me-to-a-random-secret

# The first Google sign-in with this email becomes the platform admin (only while no admin exists).
BOOTSTRAP_ADMIN_EMAIL=

ENVIRONMENT=development
# One-click stand-in for Google sign-in on local dev (only honoured with ENVIRONMENT=development)
ENABLE_DEV_LOGIN=false

# Upload limits (MiB per file; files per batch). Whole multipart requests are also capped.
MAX_FILE_SIZE_MB=50
MAX_BATCH_SIZE=200
