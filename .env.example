# Copy to .env (gitignored) and fill in.

# Google SSO — the OAuth client must list http://localhost:3001 as an authorised JavaScript origin.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Gemini (document extraction)
GEMINI_API_KEY=
ACCOUNTING_GEMINI_MODEL=gemini-3.8-flash
ACCOUNTING_GEMINI_THINKING_LEVEL=low

# Auth — any random string >= 32 chars (required outside development)
JWT_SECRET=change-me-to-a-random-secret

# The first Google sign-in with this email becomes the platform admin (only while no admin exists).
BOOTSTRAP_ADMIN_EMAIL=

ENVIRONMENT=development
